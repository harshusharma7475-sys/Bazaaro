let curLang="en";
try{const savedL=localStorage.getItem("bz_lang");if(savedL&&LANGS[savedL])curLang=savedL}catch(e){}
function tr(key,vars){
 const pack=LANGS[curLang]||LANGS.en;
 let s=pack[key]||LANGS.en[key]||key;
 if(vars)Object.keys(vars).forEach(k=>{s=s.replace("{"+k+"}",vars[k])});
 return s;
}

function svgData(bg1, bg2, innerSvg){
 const s = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 300" width="300" height="300"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="${bg1}"/><stop offset="100%" stop-color="${bg2}"/></linearGradient></defs><rect width="300" height="300" fill="url(#g)"/>${innerSvg}</svg>`;
 return "data:image/svg+xml;utf8," + encodeURIComponent(s);
}

