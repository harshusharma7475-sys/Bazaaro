function qrBox(l){try{const q=new QRLib.QRCode(-1,QRLib.E.M);q.addData(l);q.make();const n=q.getModuleCount(),m=3;let d="";for(let r=0;r<n;r++)for(let c=0;c<n;c++)if(q.isDark(r,c))d+="M"+(c+m)+" "+(r+m)+"h1v1h-1z";return`<div style="text-align:center;margin-top:12px"><svg role="img" aria-label="UPI payment QR code" viewBox="0 0 ${n+2*m} ${n+2*m}" shape-rendering="crispEdges" style="width:210px;max-width:70%;border-radius:12px;border:1px solid var(--line)"><rect width="100%" height="100%" fill="#fff"/><path d="${d}" fill="#000"/></svg><p style="font-size:12px;color:var(--mute);margin-top:6px">${esc(tr("scanOtherHint"))}</p></div>`}catch(e){return""}}
