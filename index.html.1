 if(!ids.length){$("cart").innerHTML=`<h2>${esc(tr("myCart"))}</h2><p class="none" style="padding:40px 0">${esc(tr("emptyCart"))}</p>`;return}
 const left=999-t.sub,pc=Math.min(100,t.sub/999*100);
 $("cart").innerHTML=`<h2>${esc(tr("myCart"))}</h2>
 <div class="prog">${left>0?esc(tr("freeDelivMore",{n:left})):`<span class="ok"><b>${esc(tr("freeDelivGot"))}</b></span>`}<div class="track"><div class="fill" style="width:${pc}%"></div></div></div>
 ${ids.map(k=>{const p=P.find(x=>x.id==k);return `<div class="row"><div class="e">${p.img?`<img src="${p.img}" alt="">`:""}</div><div class="m"><p>${p.n}</p><span>₹${p.p} × ${cart[k]} = ₹${p.p*cart[k]}</span><br><button class="rm" onclick="del(${p.id})">${esc(tr("remove"))}</button></div><div class="qty" style="margin:0;width:112px"><button onclick="chg(${p.id},-1)" aria-label="Decrease">−</button><b>${cart[k]}</b><button onclick="chg(${p.id},1)" aria-label="Increase">+</button></div></div>`}).join("")}
 <div class="coupon"><input id="cp" placeholder="${esc(tr("couponPlaceholder"))}" value="${coupon?"BAZAAR10":""}"><button onclick="applyCp()">${esc(tr("apply"))}</button></div>
 <div class="bill"><div><span>${esc(tr("subtotal"))}</span><span>₹${t.sub}</span></div>${coupon?`<div class="ok"><span>Coupon (${couponPercent}%)</span><span>−₹${t.disc}</span></div>`:""}<div><span>${esc(tr("delivery"))}</span><span class="${t.ship?"":"ok"}">${t.ship?"₹"+t.ship:esc(tr("free"))}</span></div><div class="t"><span>${esc(tr("total"))}</span><span>₹${t.tot}</span></div></div>
 <button class="pay" onclick="openPay()">${esc(tr("placeOrder",{n:t.tot}))}</button>`}
