function totals(){const sub=Object.keys(cart).reduce((s,k)=>s+P.find(p=>p.id==k).p*cart[k],0);
 const disc=coupon?Math.round(sub*couponPercent/100):0,ship=sub===0||sub>=999?0:49;return{sub,disc,ship,tot:sub-disc+ship}}
