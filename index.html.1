<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Bazaro – Shopping App (Version 90)</title>
<style>
:root{--bg:#eeeeee;--card:#ffffff;--ink:#222222;--mute:#6e6e6e;--pri:#4a4a4a;--onpri:#ffffff;--acc:#bdbdbd;--line:#dcdcdc;--ok:#4a4a4a;--chip:#e4e4e4;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1a1a1a;--card:#262626;--ink:#eeeeee;--mute:#a0a0a0;--pri:#d0d0d0;--onpri:#1a1a1a;--line:#3a3a3a;--ok:#cfcfcf;--chip:#333333}}
:root[data-theme="dark"]{--bg:#1a1a1a;--card:#262626;--ink:#eeeeee;--mute:#a0a0a0;--pri:#d0d0d0;--onpri:#1a1a1a;--line:#3a3a3a;--ok:#cfcfcf;--chip:#333333}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:"Segoe UI",Roboto,Arial,sans-serif;background:var(--bg);color:var(--ink);padding-bottom:88px;max-width:560px;margin:0 auto}
button{font:inherit;cursor:pointer;color:inherit}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
header{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;background:var(--pri);color:var(--onpri);position:sticky;top:0;z-index:4;margin-bottom:12px}
.av{width:42px;height:42px;border-radius:50%;border:2px solid var(--onpri);background:var(--chip) center/cover;color:var(--ink);font-size:14px;padding:0;display:inline-flex;align-items:center;justify-content:center}
.hdr-menu-btn{border:0;background:transparent;color:var(--onpri);font-size:26px;padding:4px 7px;line-height:1;display:inline-flex;align-items:center;justify-content:center;flex:none}
.hdr-menu-btn.has-photo{width:38px;height:38px;padding:0;border-radius:50%;border:2px solid var(--onpri);background-size:cover;background-position:center;background-repeat:no-repeat;font-size:0}
.img img{width:100%;height:100%;object-fit:cover;display:block}

/* Smooth Curved Slide-Out Drawer Menu */
.pm{
 position:fixed;inset:0 auto 0 0;width:min(82vw,320px);height:100dvh;
 background:var(--card);color:var(--ink);z-index:20;overflow-y:auto;
 border-radius:0 26px 26px 0;
 box-shadow:10px 0 34px rgba(0,0,0,.26);
 padding:calc(12px + env(safe-area-inset-top,0px)) 12px calc(18px + env(safe-area-inset-bottom,0px));
 transform:translateX(-106%);
 transition:transform .28s cubic-bezier(.22,1,.36,1);
 pointer-events:none;
}
.pm.open{transform:translateX(0);pointer-events:auto}
.pm-head{display:flex;align-items:center;gap:10px;padding:12px 12px;background:var(--chip);border-radius:16px;margin-bottom:10px;min-width:0}
.pm-head .av{width:34px;height:34px;font-size:13px;flex:none;background-size:cover;background-position:center}
.pm-head > div{min-width:0;flex:1}
.pm-head b{font-size:14px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pm-head .tagline{font-size:11px;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pm button{
 display:flex;align-items:center;gap:12px;width:100%;text-align:left;
 border:0;background:transparent;padding:13px 14px;font-size:15px;color:var(--ink);
 border-radius:14px;margin-bottom:4px;
}
.pm button:hover{background:var(--chip)}
.pm .seller-entry{margin-top:10px;background:transparent;font-weight:750;color:var(--ink)}
.pm .logout-btn{color:#c0392b;font-weight:600;margin-top:6px}
:root[data-theme="dark"] .pm .logout-btn{color:#ff7675}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .pm .logout-btn{color:#ff7675}}
.pm .close-menu{justify-content:center;color:var(--mute);font-size:13px;margin-top:10px;border:1px solid var(--line);border-radius:14px}
.menu-shade{
 position:fixed;inset:0;background:rgba(0,0,0,.42);z-index:19;
 opacity:0;pointer-events:none;transition:opacity .26s ease;
}
.menu-shade.open{opacity:1;pointer-events:auto}

.ph{font-size:13px;font-weight:700;color:var(--mute);padding:10px;text-align:center}
.pill{display:inline-block;background:var(--pri);color:var(--onpri);border-radius:8px;padding:2px 7px;font-weight:700;font-size:12px}
.logo{font-size:24px;font-weight:800;color:var(--onpri);letter-spacing:-.5px}
.tag{font-size:12px;color:var(--onpri);opacity:.85}
.cartbtn{position:relative;background:var(--card);color:var(--ink);border:0;border-radius:12px;padding:10px 16px;font-size:14px;font-weight:700}
.badge{position:absolute;top:-6px;right:-6px;background:var(--acc);color:#1a1a1a;font-size:12px;font-weight:700;border-radius:10px;min-width:20px;padding:2px 5px;text-align:center}
.bar{display:flex;gap:8px;padding:0 16px 12px}
.bar input{flex:1;min-width:0;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:14px;padding:12px 14px;font-size:16px}
.cat-section{padding:0 16px 14px}
.cat-sec-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.cat-sec-head h3{font-size:15px;font-weight:750;color:var(--ink)}
.cat-sec-head span{font-size:12px;color:var(--mute)}
.cat-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px 8px}
.cat-item{display:flex;flex-direction:column;align-items:center;gap:6px;border:0;background:transparent;padding:4px 2px;text-align:center}
.cat-thumb{width:62px;height:62px;border-radius:50%;overflow:hidden;border:3px solid rgba(255,255,255,.9);background:var(--card);box-shadow:0 6px 14px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease}
.cat-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.cat-item.on .cat-thumb{border-color:#ffffff;box-shadow:0 0 0 2px rgba(255,255,255,.35),0 6px 14px rgba(0,0,0,.35);transform:scale(1.03)}
.cat-lbl{font-size:11px;font-weight:600;color:var(--ink);line-height:1.2;max-width:74px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cat-item.on .cat-lbl{font-weight:800;color:var(--pri)}
.cat-sub-bar{display:none!important}
.sub-pill{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:16px;padding:6px 12px;font-size:12px;white-space:nowrap;display:inline-flex;align-items:center;gap:6px}
.sub-pill .sub-ico{width:20px;height:20px;border-radius:50%;overflow:hidden;flex:none;border:1px solid var(--line);background:#fff}
.sub-pill .sub-ico img{width:100%;height:100%;object-fit:cover;display:block}
.sub-pill.on{background:var(--pri);color:var(--onpri);border-color:var(--pri);font-weight:600}
.banner{margin:4px 16px 16px;padding:20px;border-radius:20px;background:var(--pri);color:var(--onpri)}
.banner h2{font-size:21px;margin-bottom:4px}.banner p{font-size:14px;opacity:.9}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding:0 16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:12px;display:flex;flex-direction:column;min-width:0}
.img{position:relative;background:var(--chip);border-radius:14px;height:150px;overflow:hidden;display:flex;align-items:center;justify-content:center;margin-bottom:10px}
.off{position:absolute;left:8px;top:8px;background:var(--ok);color:#fff;font-size:11px;font-weight:700;border-radius:8px;padding:2px 7px}
.heart{position:absolute;right:6px;top:6px;border:0;background:transparent;font-size:20px;padding:4px}
.card h3{font-size:14px;font-weight:600;min-height:36px;margin-bottom:4px}
.rate{font-size:12px;color:var(--mute);margin-bottom:6px}
.price{font-size:18px;font-weight:800;margin-bottom:10px}.price s{font-size:12px;font-weight:400;color:var(--mute);margin-left:6px}
.add{margin-top:auto;width:100%;border:0;border-radius:12px;padding:10px;background:var(--pri);color:var(--onpri);font-weight:600;font-size:14px}
.qty{margin-top:auto;display:flex;align-items:center;justify-content:space-between;background:var(--chip);border-radius:12px}
.qty button{border:0;background:transparent;font-size:20px;width:40px;height:38px}
.qty b{font-size:15px}
.none{grid-column:1/-1;text-align:center;color:var(--mute);padding:30px 0}
#cart,#shop{display:none;padding:0 16px}
#shop h2{font-size:20px;margin:6px 0 12px}
.form{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px;margin-bottom:16px}
.lb{display:block;font-size:13px;color:var(--mute);margin:10px 0 4px}
.fi{width:100%;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:12px;padding:12px;font-size:15px}

/* Custom Bazaaro Dropdown */
.bz-sel-btn{width:100%;display:flex;align-items:center;justify-content:space-between;gap:8px;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:14px;padding:12px 14px;font-size:15px;text-align:left}
.bz-sel-btn.compact{width:auto;min-width:96px;padding:10px 12px;font-size:13px;border-radius:12px;background:var(--bg)}
.bz-sel-btn.bar-sel{width:auto;min-width:94px;padding:12px;font-size:14px;border-radius:14px}
.bz-sel-btn .arrow{color:var(--mute);font-size:12px;flex:none}
.bz-opt{display:flex;align-items:center;justify-content:space-between;width:100%;padding:15px 14px;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:14px;margin-top:8px;font-size:15px;text-align:left}
.bz-opt.on{background:var(--chip);border-color:var(--pri);font-weight:700}
.bz-radio{width:20px;height:20px;border-radius:50%;border:2px solid var(--mute);display:inline-flex;align-items:center;justify-content:center;flex:none}
.bz-opt.on .bz-radio{border-color:var(--pri)}
.bz-opt.on .bz-radio::after{content:"";width:10px;height:10px;border-radius:50%;background:var(--pri)}

/* Seller Payment Settings Tabs */
.pm-tabs{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
.pm-tab{border:1px solid var(--line);background:var(--bg);color:var(--mute);border-radius:12px;padding:11px 10px;font-size:13px;font-weight:600;text-align:center}
.pm-tab.on{background:var(--pri);color:var(--onpri);border-color:var(--pri)}
.qr-preview-box{margin-top:10px;padding:12px;border:1px dashed var(--line);border-radius:12px;background:var(--bg);text-align:center}
.qr-preview-box img{max-width:160px;max-height:160px;border-radius:10px;border:1px solid var(--line);display:block;margin:0 auto 6px}

#cart h2{font-size:20px;margin:6px 0 12px}
.row{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:12px;margin-bottom:10px;display:flex;gap:12px;align-items:center}
.row .e{width:56px;height:56px;flex:none;border-radius:12px;overflow:hidden;background:var(--chip)}.row .e img{width:100%;height:100%;object-fit:cover;display:block}.row .m{flex:1;min-width:0}.row .m p{font-size:14px;font-weight:600}.row .m span{font-size:13px;color:var(--mute)}
.rm{border:0;background:transparent;color:var(--mute);font-size:13px;margin-top:4px;padding:0;text-decoration:underline}
.prog{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:12px;margin-bottom:12px;font-size:13px}
.track{height:8px;background:var(--chip);border-radius:6px;margin-top:8px;overflow:hidden}
.fill{height:100%;background:var(--ok);border-radius:6px;transition:width .3s}
.coupon{display:flex;gap:8px;margin-bottom:12px}
.coupon input{flex:1;min-width:0;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:12px;padding:12px;font-size:15px;text-transform:uppercase}
.coupon button{border:0;border-radius:12px;background:var(--chip);padding:0 18px;font-weight:600}
.bill{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px;font-size:14px}
.bill div{display:flex;justify-content:space-between;margin-bottom:8px}
.bill .t{font-size:18px;font-weight:800;margin:6px 0 0;padding-top:10px;border-top:1px dashed var(--line)}
.ok{color:var(--ok)}
.pay{width:100%;border:0;border-radius:14px;background:var(--pri);color:var(--onpri);padding:15px;font-size:16px;font-weight:700;margin-top:14px}

/* Smooth Curved Bottom Navigation */
nav{
 position:fixed;bottom:8px;left:50%;transform:translateX(-50%);
 width:calc(100% - 20px);max-width:540px;
 background:var(--card);border:1px solid var(--line);
 border-radius:24px;
 box-shadow:0 6px 24px rgba(0,0,0,.14);
 display:flex;justify-content:space-around;gap:6px;
 padding:7px 10px calc(7px + env(safe-area-inset-bottom,0px));z-index:5;
}
nav button{border:0;background:transparent;font-size:11px;padding:7px 5px;border-radius:16px;color:var(--mute);flex:1;min-width:0;white-space:nowrap}
nav button .nav-ico{display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;margin-bottom:1px;filter:grayscale(100%) opacity(.62);transition:filter .2s ease,transform .2s ease}
nav button.on{color:var(--pri);font-weight:700;background:transparent}
nav button.on .nav-ico{filter:grayscale(25%) opacity(1);transform:scale(1.06)}
.hidden-nav{display:none!important}

.page{display:none;padding:0 16px}
.page h2{font-size:20px;margin:6px 0 12px}
.order-card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px;margin-bottom:12px}
.order-head{display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:8px}
.status-pill{display:inline-block;background:var(--chip);border-radius:20px;padding:5px 9px;font-size:12px;font-weight:700}
.steps{display:flex;justify-content:space-between;gap:4px;margin:16px 0 8px}
.step{flex:1;text-align:center;font-size:10px;color:var(--mute)}
.step-dot{width:13px;height:13px;border-radius:50%;background:var(--chip);border:2px solid var(--line);margin:0 auto 5px}
.step.done .step-dot{background:var(--pri);border-color:var(--pri)}
.track-line{height:5px;background:var(--chip);border-radius:5px;overflow:hidden;margin:8px 0 12px}
.track-line span{display:block;height:100%;background:var(--pri);transition:width .25s}
.small-action{border:1px solid var(--line);background:var(--chip);border-radius:11px;padding:9px 12px;font-size:13px;font-weight:600;margin-top:8px}
#toast{position:fixed;left:50%;bottom:96px;transform:translateX(-50%) translateY(20px);background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:14px;font-size:14px;opacity:0;pointer-events:none;transition:.25s;z-index:15;white-space:nowrap}
#toast.show{opacity:1;transform:translateX(-50%)}
#done{position:fixed;inset:0;background:rgba(10,10,25,.7);display:none;align-items:center;justify-content:center;padding:24px;z-index:9}
#done div{background:var(--card);border-radius:22px;padding:28px 22px;text-align:center;max-width:340px}
#done h2{margin:8px 0}#done p{color:var(--mute);font-size:14px;line-height:1.5;margin-bottom:16px}
#paym{position:fixed;inset:0;background:rgba(0,0,0,.68);display:none;align-items:flex-end;justify-content:center;z-index:12}
#paym .sheet{background:var(--card);color:var(--ink);width:100%;max-width:560px;border-radius:24px 24px 0 0;padding:18px 16px calc(18px + env(safe-area-inset-bottom,0px));max-height:90vh;overflow-y:auto;border-top:1px solid var(--line)}
.po{display:flex;gap:12px;align-items:center;width:100%;text-align:left;border:2px solid var(--line);background:var(--card);border-radius:16px;padding:13px;margin-top:10px}
.po.on{border-color:var(--pri);background:var(--chip)}
.po small{display:block;color:var(--mute);font-size:12px;margin-top:2px}
.po:disabled{opacity:.5;cursor:not-allowed}
.upi{margin-top:6px;font-size:14px}
.upi a.pay{display:block;text-align:center;text-decoration:none}
.sec{width:100%;border:1px solid var(--line);background:var(--chip);border-radius:14px;padding:12px;font-size:14px;font-weight:600;margin-top:10px}
.kpi-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:12px 0}
.kpi{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:13px;min-width:0}
.kpi small{display:block;color:var(--mute);font-size:12px;margin-bottom:7px}
.kpi strong{font-size:21px;display:block;overflow-wrap:anywhere}
.kpi em{font-style:normal;font-size:11px;color:var(--mute)}
.dash-title{font-size:17px;font-weight:750;margin:18px 0 9px;scroll-margin-top:72px}
.overview-head{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:18px 0 9px;flex-wrap:wrap}
.overview-head .dash-title{margin:0}
.range-btn{display:inline-flex;align-items:center;gap:6px;background:var(--card);border:1px solid var(--line);border-radius:20px;padding:6px 12px;font-size:12px;font-weight:600;color:var(--pri)}
.chart{display:flex;align-items:flex-end;gap:6px;height:148px;padding:14px 8px 4px;background:var(--card);border:1px solid var(--line);border-radius:16px;overflow-x:auto}
.chart-col{flex:1;min-width:26px;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:5px}
.chart-bar{width:100%;max-width:26px;min-height:3px;background:var(--pri);border-radius:6px 6px 2px 2px}
.chart-col small{font-size:9px;color:var(--mute);white-space:nowrap}
.chart-col b{font-size:9px;color:var(--mute);font-weight:500}
.tagline{font-size:12px;color:var(--mute);line-height:1.45;margin:5px 0 10px}
.seller-search-box{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:12px;margin-bottom:14px}
.seller-search-row{display:flex;gap:8px;align-items:center}
.seller-search-row input{flex:1;min-width:0;border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:12px;padding:10px 12px;font-size:14px}
.hist-chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px;align-items:center}
.hist-chip{border:1px solid var(--line);background:var(--chip);border-radius:16px;padding:4px 10px;font-size:11px;display:inline-flex;align-items:center;gap:5px}
.hist-chip span{color:var(--mute);font-size:10px}
.meta-badge{display:inline-block;background:var(--chip);border-radius:8px;padding:2px 7px;font-size:11px;color:var(--mute);margin-top:4px}
*{-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth}
button,.product,.order-card,.row,.cartbtn,.seller-entry{transition:transform .16s ease,opacity .16s ease,background-color .18s ease,box-shadow .18s ease,border-color .18s ease;touch-action:manipulation}
button:active,.product:active,.order-card:active,.row:active{transform:scale(.985);opacity:.88}
button:focus:not(:focus-visible){outline:none}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--pri);outline-offset:2px}
.order-actions{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:12px}
.order-actions .small-action{margin-top:0;flex:1;min-width:0}
.order-actions .track-action{background:var(--pri);color:var(--onpri);border-color:var(--pri)}
.order-search{width:100%;box-sizing:border-box;margin:8px 0 14px;padding:12px 14px;border:1px solid var(--line);border-radius:14px;background:var(--card);color:var(--ink);font:inherit}
.order-empty{padding:22px 12px;text-align:center;color:var(--mute)}
.order-card{animation:orderIn .24s ease both}
@keyframes orderIn{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:translateY(0)}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;transition-duration:.01ms!important}}

.home-feature-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:14px 0 18px}
.home-feature{min-width:0;min-height:174px;border:1px solid rgba(255,255,255,.12);border-radius:20px;padding:10px 9px 12px;display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between;text-align:left;color:#f8fafc;overflow:hidden;position:relative;box-shadow:0 7px 18px rgba(0,0,0,.2)}
.verify-feature{background:linear-gradient(145deg,#334155,#111827 78%)}
.manage-feature{background:linear-gradient(145deg,#4c1d95,#171326 82%)}
.advertise-feature{background:linear-gradient(145deg,#9a3412,#211713 82%)}
.feature-art{width:100%;height:82px;display:flex;align-items:center;justify-content:center;border-radius:13px;background:rgba(255,255,255,.09)}
.feature-art svg{height:78px;width:100%;max-width:125px;filter:drop-shadow(0 4px 5px rgba(0,0,0,.25))}
.feature-copy{display:flex;flex-direction:column;gap:4px;max-width:100%;padding:2px 0}
.feature-copy b{font-size:clamp(12px,3.4vw,16px);line-height:1.2;white-space:nowrap}
.feature-copy small{font-size:clamp(9px,2.6vw,11px);color:#d1d5db;white-space:nowrap}
.feature-arrow{position:absolute;right:8px;bottom:11px;width:24px;height:24px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.2);font-size:23px;line-height:1}
@media(min-width:600px){.home-feature-grid{gap:14px}.home-feature{min-height:205px;padding:14px}.feature-art{height:105px}.feature-art svg{height:100px}}
.store-pills{scrollbar-width:none;-ms-overflow-style:none}
.store-pills::-webkit-scrollbar{display:none;height:0}
.home-feature-grid{grid-template-columns:1fr;margin:6px 0 16px}
.home-feature{min-height:0;flex-direction:row;align-items:center;justify-content:flex-start;gap:14px;padding:12px 56px 12px 12px}
.feature-art{width:72px;height:60px;flex:none}
.feature-art svg{height:54px;width:auto;max-width:68px}
.feature-copy b{font-size:16px}
.feature-copy small{font-size:12px}
.feature-arrow{top:50%;bottom:auto;right:14px;transform:translateY(-50%)}
button{transition:background-color .25s ease,color .25s ease,border-color .25s ease,box-shadow .25s ease,transform .18s ease,opacity .2s ease}
button:active{transform:scale(.97)}
@media(prefers-reduced-motion:reduce){button{transition:none}button:active{transform:none}}

/* Seller email-verification account flow */
.seller-auth-note{font-size:12px;color:var(--mute);line-height:1.5;margin:8px 0}
.seller-auth-status{padding:10px 12px;border-radius:12px;background:var(--chip);font-size:13px;line-height:1.45;margin:10px 0}
.seller-auth-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.seller-auth-actions button{min-width:0}
</style>
</head>
<body>
<header style="justify-content:space-between;gap:10px">
<div style="display:flex;align-items:center;gap:12px;min-width:0">
<button id="av" onclick="menu()" aria-label="Open menu" class="hdr-menu-btn">☰</button>
<div><div class="logo">Bazaaro</div><div class="tag" id="hdrTag">Everything, in one place</div></div>
</div>
<div style="display:flex;align-items:center;gap:8px">
<button class="cartbtn" onclick="go('cart')" aria-label="Open Cart">🛒 <span id="hdrCartLbl">Cart</span><span class="badge" id="cnt">0</span></button>
</div>
</header>
<div class="menu-shade" id="menuShade" onclick="menu(false)"></div>
<div class="pm" id="pm" aria-label="Main menu">
<div class="pm-head" style="cursor:pointer" onclick="if(!event.target.closest('#menuAv'))document.getElementById('pfp').click()">
 <button class="av" id="menuAv" onclick="document.getElementById('pfp').click()" aria-label="Change profile photo">🙂</button>
 <div><b id="menuAccTitle">My Account</b><div class="tagline" id="menuAccSub" style="margin:3px 0 0">Profile &amp; app settings</div></div>
</div>
<button onclick="go('orders');menu(false)" id="mBtnOrders">📦 My Orders</button>
<button onclick="openLanguagePicker();menu(false)" id="mBtnLang">🌐 Language · English</button>
<button onclick="openFeedbackModal();menu(false)" id="mBtnFeedback">💬 Feedback</button>
<button class="logout-btn" onclick="logoutUser();menu(false)" id="mBtnLogout">🚪 Log Out</button>
<button class="seller-entry" onclick="openSellerAuth();menu(false)" id="mBtnSeller">🏪 Seller Registration / Login</button>
<button class="close-menu" onclick="menu(false)" id="mBtnClose">Close Menu ✕</button>
</div>
<input id="pfp" type="file" accept="image/*" hidden onchange="setAv(this.files[0])">

<main id="home">
<div class="bar"><input id="q" type="search" placeholder="Search products..." oninput="draw()">
<button type="button" class="bz-sel-btn bar-sel" id="homeSortBtn" onclick="openHomeSortPicker()"><span id="homeSortLbl">Sort</span><span class="arrow">▾</span></button></div>
<div class="cat-section" id="catHub"></div>
<div class="home-feature-grid" aria-label="Quick services">
</div>
<div class="banner"><h2 id="banTitle">Free delivery above ₹1,500</h2><p id="banSub">Apply coupon BAZAAR10 to save 10% extra</p></div>
<div class="grid" id="grid"></div>
</main>

<section id="cart"></section>
<section id="shop"></section>
<section id="orders" class="page"></section>
<section id="track" class="page"></section>

<nav aria-label="Bottom Navigation">
