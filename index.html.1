function getOrderDate(o){
 return o.createdAt?new Date(o.createdAt):new Date(o.created||0);
}

function drawSellerAnalytics(){
 const allRows=ORD.filter(o=>!o.x).flatMap(o=>(o.it||[]).filter(i=>(i.s||"Bazaaro")===shopName).map(i=>({o,i,d:getOrderDate(o)})));
 const nowD=new Date();
 let startD=new Date(),endD=new Date();
 endD.setHours(23,59,59,999);

 if(overviewRange.type==="7d"){
  startD=new Date();startD.setDate(nowD.getDate()-6);startD.setHours(0,0,0,0);
 }else if(overviewRange.type==="30d"){
  startD=new Date();startD.setDate(nowD.getDate()-29);startD.setHours(0,0,0,0);
 }else if(overviewRange.type==="month"){
  startD=new Date(overviewRange.year,overviewRange.month,1,0,0,0,0);
  endD=new Date(overviewRange.year,overviewRange.month+1,0,23,59,59,999);
 }else if(overviewRange.type==="year"){
  startD=new Date(overviewRange.year,0,1,0,0,0,0);
  endD=new Date(overviewRange.year,11,31,23,59,59,999);
 }else if(overviewRange.type==="multi"){
  const yrs=overviewRange.years||7;
  startD=new Date(nowD.getFullYear()-yrs+1,0,1,0,0,0,0);
 }else if(overviewRange.type==="custom"&&overviewRange.from&&overviewRange.to){
  startD=new Date(overviewRange.from+"T00:00:00");
  endD=new Date(overviewRange.to+"T23:59:59");
 }

 const rows=allRows.filter(x=>x.d>=startD&&x.d<=endD);
 const gross=rows.reduce((a,x)=>a+(Number(x.i.p)||0)*(Number(x.i.q)||0),0);
 const commission=gross*.01;
 const costKnown=rows.filter(x=>Number(x.i.cost)>0);
 const knownGross=costKnown.reduce((a,x)=>a+(Number(x.i.p)||0)*(Number(x.i.q)||0),0);
 const estimated=costKnown.reduce((a,x)=>a+((Number(x.i.p)||0)-(Number(x.i.cost)||0))*(Number(x.i.q)||0),0)-knownGross*.01;
 const isToday=d=>d.toDateString()===nowD.toDateString();
 const todayGross=allRows.filter(x=>isToday(x.d)).reduce((a,x)=>a+(Number(x.i.p)||0)*(Number(x.i.q)||0),0);
 const orderCount=new Set(rows.map(x=>x.o.id)).size;

 $("sellerKpis").innerHTML=`<div class="kpi"><small>${L("Gross Sales")} (${esc(L(overviewRange.label))})</small><strong>₹${gross.toFixed(0)}</strong><em>${L("Selected period sales")}</em></div>
 <div class="kpi"><small>Today's Sales</small><strong>₹${todayGross.toFixed(0)}</strong><em>Today only</em></div>
 <div class="kpi"><small>Orders</small><strong>${orderCount}</strong><em>Orders in selected period</em></div>
 <div class="kpi"><small>1% Bazaaro Commission</small><strong>₹${commission.toFixed(2)}</strong><em>Based on period sales</em></div>
 <div class="kpi"><small>Estimated Profit</small><strong>${costKnown.length?"₹"+estimated.toFixed(2):"—"}</strong><em>${costKnown.length?"Estimate for items with cost entered":"Add cost price to estimate"}</em></div>
 <div class="kpi"><small>Delivered Sales</small><strong>₹${rows.filter(x=>Number(x.o.st)===4).reduce((a,x)=>a+(Number(x.i.p)||0)*(Number(x.i.q)||0),0).toFixed(0)}</strong><em>Marked delivered</em></div>`;

 let buckets=[];
 if(overviewRange.type==="7d"){
  for(let n=6;n>=0;n--){
   const d=new Date();d.setHours(0,0,0,0);d.setDate(d.getDate()-n);
   const total=rows.filter(x=>x.d.toDateString()===d.toDateString()).reduce((a,x)=>a+(Number(x.i.p)||0)*(Number(x.i.q)||0),0);
   buckets.push({label:d.toLocaleDateString("en-IN",{weekday:"short"}),total});
  }
 }else if(overviewRange.type==="30d"){
  for(let b=5;b>=0;b--){
   const bEnd=new Date();bEnd.setHours(23,59,59,999);bEnd.setDate(nowD.getDate()-b*5);
   const bStart=new Date(bEnd);bStart.setHours(0,0,0,0);bStart.setDate(bEnd.getDate()-4);
   const total=rows.filter(x=>x.d>=bStart&&x.d<=bEnd).reduce((a,x)=>a+(Number(x.i.p)||0)*(Number(x.i.q)||0),0);
   buckets.push({label:bStart.getDate()+"/"+(bStart.getMonth()+1),total});
  }
 }else if(overviewRange.type==="month"){
  const daysInM=new Date(overviewRange.year,overviewRange.month+1,0).getDate();
  for(let w=0;w<5;w++){
   const d1=w*7+1,d2=Math.min(daysInM,(w+1)*7);
   if(d1>daysInM)break;
   const total=rows.filter(x=>x.d.getDate()>=d1&&x.d.getDate()<=d2).reduce((a,x)=>a+(Number(x.i.p)||0)*(Number(x.i.q)||0),0);
   buckets.push({label:d1+"-"+d2,total});
  }
 }else if(overviewRange.type==="year"){
  const mNames=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  for(let m=0;m<12;m++){
   const total=rows.filter(x=>x.d.getMonth()===m).reduce((a,x)=>a+(Number(x.i.p)||0)*(Number(x.i.q)||0),0);
   buckets.push({label:mNames[m],total});
  }
 }else if(overviewRange.type==="multi"){
  const yrs=overviewRange.years||7;
  const curY=nowD.getFullYear();
  for(let y=curY-yrs+1;y<=curY;y++){
   const total=rows.filter(x=>x.d.getFullYear()===y).reduce((a,x)=>a+(Number(x.i.p)||0)*(Number(x.i.q)||0),0);
   buckets.push({label:String(y),total});
  }
 }else if(overviewRange.type==="custom"){
  const diffDays=Math.max(1,Math.ceil((endD-startD)/864e5));
  const step=Math.max(1,Math.ceil(diffDays/8));
  for(let t=startD.getTime();t<=endD.getTime();t+=step*864e5){
   const bS=new Date(t),bE=new Date(Math.min(endD.getTime(),t+step*864e5-1));
   const total=rows.filter(x=>x.d>=bS&&x.d<=bE).reduce((a,x)=>a+(Number(x.i.p)||0)*(Number(x.i.q)||0),0);
   buckets.push({label:bS.getDate()+"/"+(bS.getMonth()+1),total});
  }
 }

 const max=Math.max(1,...buckets.map(x=>x.total));
 $("sellerChart").innerHTML=buckets.map(d=>`<div class="chart-col"><b>₹${Math.round(d.total)}</b><div class="chart-bar" style="height:${Math.max(3,d.total/max*82)}%"></div><small>${d.label}</small></div>`).join("");
}

function openOverviewPicker(){
 const curY=new Date().getFullYear();
 const years=[];for(let y=curY;y>=curY-15;y--)years.push(y);
 const months=["January","February","March","April","May","June","July","August","September","October","November","December"];
 $("paysheet").innerHTML=`<h2 style="font-size:19px">Select Sales Overview Period</h2>
 <p style="font-size:13px;color:var(--mute);margin-top:2px">View sales by days, month, year, multi-year, or custom date range</p>
 <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px">
  <button class="po ${overviewRange.type==="7d"?"on":""}" style="margin:0" onclick="applyOverviewPreset('7d','Last 7 Days')"><b>Last 7 Days</b></button>
  <button class="po ${overviewRange.type==="30d"?"on":""}" style="margin:0" onclick="applyOverviewPreset('30d','Last 30 Days')"><b>Last 30 Days</b></button>
  <button class="po ${overviewRange.type==="year"&&overviewRange.year===curY?"on":""}" style="margin:0" onclick="applyOverviewYear(${curY})"><b>1 Year (${curY})</b></button>
  <button class="po ${overviewRange.type==="multi"&&(overviewRange.years||7)===7?"on":""}" style="margin:0" onclick="applyOverviewMulti(7)"><b>Last 7 Years</b></button>
 </div>

 <label class="lb" for="ovMonthSel">Specific Month &amp; Year</label>
 <div style="display:flex;gap:8px">
  <select class="fi" id="ovMonthSel">${months.map((m,i)=>`<option value="${i}" ${i===overviewRange.month?"selected":""}>${m}</option>`).join("")}</select>
  <select class="fi" id="ovMonthYearSel">${years.map(y=>`<option value="${y}" ${y===overviewRange.year?"selected":""}>${y}</option>`).join("")}</select>
 </div>
 <button class="small-action" style="width:100%" onclick="applyOverviewMonth()">View Selected Month</button>

 <label class="lb" for="ovYearOnlySel">Specific Year</label>
 <div style="display:flex;gap:8px">
  <select class="fi" id="ovYearOnlySel">${years.map(y=>`<option value="${y}" ${y===overviewRange.year?"selected":""}>${y}</option>`).join("")}</select>
  <button class="small-action" style="margin:0;white-space:nowrap" onclick="applyOverviewYear(Number($('ovYearOnlySel').value))">View Year</button>
 </div>

 <label class="lb" for="ovMultiYrs">Years Back (e.g. 5, 7, 10 Years)</label>
 <div style="display:flex;gap:8px">
  <input class="fi" id="ovMultiYrs" type="number" min="2" max="30" value="${overviewRange.years||7}">
  <button class="small-action" style="margin:0;white-space:nowrap" onclick="applyOverviewMulti(Math.max(2,Math.min(30,Number($('ovMultiYrs').value)||7)))">View Years</button>
 </div>

 <label class="lb">Custom Date Range (From – To)</label>
 <div style="display:flex;gap:8px">
  <input class="fi" id="ovFrom" type="date" value="${overviewRange.from||""}">
  <input class="fi" id="ovTo" type="date" value="${overviewRange.to||""}">
 </div>
 <button class="pay" onclick="applyOverviewCustom()">Apply Custom Range</button>
 <button class="sec" onclick="closePay()">${esc(tr("close"))}</button>`;
 $("paym").style.display="flex";
}

function applyOverviewPreset(type,label){
 overviewRange={type,label,year:new Date().getFullYear(),month:new Date().getMonth(),from:"",to:""};
 closePay();drawShop();
}
function applyOverviewMonth(){
 const m=Number($("ovMonthSel").value),y=Number($("ovMonthYearSel").value);
 const mShort=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"][m];
 overviewRange={type:"month",label:mShort+" "+y,year:y,month:m,from:"",to:""};
 closePay();drawShop();
}
function applyOverviewYear(y){
 overviewRange={type:"year",label:"Year "+y,year:y,month:0,from:"",to:""};
 closePay();drawShop();
}
function applyOverviewMulti(yrs){
 overviewRange={type:"multi",label:"Last "+yrs+" Years",years:yrs,year:new Date().getFullYear(),month:0,from:"",to:""};
 closePay();drawShop();
}
function applyOverviewCustom(){
 const f=$("ovFrom").value,t=$("ovTo").value;
 if(!f||!t||f>t){toast("Select valid start and end dates");return}
 overviewRange={type:"custom",label:f+" → "+t,year:new Date().getFullYear(),month:0,from:f,to:t};
 closePay();drawShop();
}

function saveSellerCoupon(){
 const code=($("scCode").value||"").trim().toUpperCase(),discount=Number($("scDiscount").value);
 if(!/^[A-Z0-9_-]{3,18}$/.test(code)||!(discount>=1&&discount<=50)){toast("Enter a valid code and 1–50% discount");return}
 sellerCoupon={code,discount};try{localStorage.setItem("bzscoupon",JSON.stringify(sellerCoupon))}catch(e){}
 toast("Coupon saved");
}
function createSellerAd(){
 const budget=Math.round(Number($("adBudget").value)),days=Number($("adDays").value);
 if(!(budget>=50)){toast("Minimum demo budget is ₹50");return}
 sellerAds.unshift({id:"AD"+Date.now(),budget,days,status:"Draft · Awaiting setup",createdAt:Date.now()});
 try{localStorage.setItem("bzsads",JSON.stringify(sellerAds))}catch(e){}
 $("adBudget").value="";drawSellerAds();toast("Promotion request saved as draft");
}
function drawSellerAds(){
 const el=$("sellerAds");if(!el)return;
 el.innerHTML=sellerAds.length?sellerAds.map(a=>`<div class="row"><div class="m"><p>Promotion · ₹${a.budget} / ${a.days} days</p><span>${esc(a.status)} · ${new Date(a.createdAt).toLocaleDateString("en-IN")}</span></div></div>`).join(""):`<p class="tagline">No promotion requests yet.</p>`;
}
function drawMine(){
 const el=$("mine");if(!el)return;
 const q=String(sellerProdQuery||"").trim().toLowerCase();
 const list=SELL.slice().reverse().filter(p=>{
  const matchCat=(sellerProdCat==="All"||p.c===sellerProdCat);
  const matchTxt=!q||[p.n,p.c,p.w,p.shop,p.addedAt].filter(Boolean).join(" ").toLowerCase().includes(q);
  return matchCat&&matchTxt;
 });
 if(!SELL.length){
  el.innerHTML=`<p class="none" style="padding:20px 0">${esc(tr("noAddedYet"))}</p>`;
  return;
 }
 el.innerHTML=list.length?list.map(p=>`<div class="row"><div class="e">${p.img?`<img src="${p.img}" alt="">`:""}</div><div class="m"><p>${p.n}</p><span>₹${p.p}${p.cost?` · Cost ₹${p.cost}`:""} · ${p.c}${p.w?" · "+esc(p.w):""}</span><br><span class="meta-badge">${p.addedAt?`Added: ${esc(p.addedAt)}`:`Saved Product`}</span><br><button class="rm" onclick="delProd(${p.id})">${esc(tr("remove"))}</button></div></div>`).join(""):`<p class="none" style="padding:20px 0">No matching products for "${esc(sellerProdQuery)}".</p>`;
}
function statusName(st){
 const steps=tr("orderSteps");
 return steps[Math.max(0,Math.min(4,Number(st)||0))];
}
function trackingMarkup(o){
 const st=Math.max(0,Math.min(4,Number(o.st)||0));
 const steps=tr("orderSteps");
 return `<div class="order-card">
   <div class="order-head"><b>Order #${o.id}</b><span class="status-pill">${o.x?"Cancelled":statusName(st)}</span></div>
   <p style="font-size:13px;color:var(--mute)">${esc(tr("total"))}: ₹${o.t} · ${o.created||"Order details saved"}</p>
   <div class="track-line"><span style="width:${st*25}%"></span></div>
   <div class="steps" ${o.x?'style="opacity:.35"':""}>${steps.map((label,i)=>`<div class="step ${i<=st?"done":""}"><div class="step-dot"></div>${esc(label)}</div>`).join("")}</div>
   <p style="font-size:13px;margin-top:10px">${o.it.map(x=>`${x.n} × ${x.q}`).join(", ")}</p>${cxLine(o)}${cxBtn(o)}
 </div>`;
}
function drawOrders(){
 $("orders").innerHTML=`<h2>${esc(tr("myOrders"))}</h2>
 <input class="order-search" id="orderSearch" type="search" placeholder="${esc(tr("searchOrdersPlaceholder"))}" oninput="filterOrders(this.value)" autocomplete="off">
 <div id="orderList"></div>`;
 filterOrders("");
}
function filterOrders(query){
 const host=$("orderList");if(!host)return;
 const q=String(query||"").trim().toLowerCase();
 const matches=ORD.filter(o=>{
   const searchable=[o.id,o.st===undefined?"":statusName(o.st),o.pm||"",...(o.it||[]).flatMap(i=>[i.n,i.s,i.q])].join(" ").toLowerCase();
   return searchable.includes(q);
 });
 host.innerHTML=matches.length?matches.map(o=>`
  <div class="order-card">
   <div class="order-head"><b>Order #${o.id}</b><span class="status-pill">${stText(o)}</span></div>
   <p style="font-size:13px;color:var(--mute)">${esc(tr("total"))} ₹${o.t} · ${o.created||"Order saved"}</p>
   ${o.pm?`<p style="font-size:13px;margin-top:6px"><b>${payLabel(o)}</b></p>`:""}
   <p style="font-size:13px;margin-top:8px">${(o.it||[]).map(x=>x.n+" × "+x.q).join(", ")}</p>
   ${cxLine(o)}
   <div class="order-actions">
    <button class="small-action track-action" onclick="trackOrder('${o.id}')">${esc(tr("viewTrack"))}</button>
    ${cxBtn(o)}
   </div>
  </div>`).join(""):`<div class="order-empty">${esc(ORD.length?tr("noMatchingOrders"):tr("noOrders"))}</div>`;
}
function trackOrder(id){selectedOrderId=id;go("track")}
function drawTrack(){
 const o=ORD.find(x=>x.id===selectedOrderId)||ORD[0];
 $("track").innerHTML=`<h2>${esc(tr("orderTracker"))}</h2>`+(o?trackingMarkup(o)+`<p style="font-size:13px;color:var(--mute);margin:8px 2px">${esc(tr("trackerNote"))}</p>`:`<p class="none">${esc(tr("noTrackParcel"))}</p>`);
}
function drawOrds(){const el=$("ords");if(!el)return;el.innerHTML=ORD.length?ORD.map((o,i)=>`<div class="row"><div class="m"><p>#${o.id} · ₹${o.t}</p><span>${o.it.map(x=>x.n+" ×"+x.q+" ("+x.s+")").join(", ")}</span><br><span class="status-pill">${stText(o)}</span><br>${o.x?`<span>Reason: ${o.x.r}</span><br>`:""}${o.pm?`<span>${payLabel(o)}</span><br>${o.paid||o.x?"":`<button class="rm" onclick="markPaid(${i})">Mark Payment Received ✓</button><br>`}`:""}${o.x?"":`<button class="rm" onclick="setOrd(${i})">${Number(o.st)>=4?"Delivered ✓":"Advance Order Status →"}</button>`}</div></div>`).join(""):`<p class="none" style="padding:20px 0">No customer orders yet.</p>`}
function setOrd(i){if(ORD[i].x)return;ORD[i].st=Math.min(4,(Number(ORD[i].st)||0)+1);try{localStorage.setItem("bzo",JSON.stringify(ORD))}catch(e){}drawOrds();if(view==="orders")drawOrders();if(view==="track")drawTrack();toast("Order status: "+statusName(ORD[i].st))}
function rd(f,cb){const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const s=Math.min(1,600/Math.max(im.width,im.height)),c=document.createElement("canvas");c.width=im.width*s;c.height=im.height*s;c.getContext("2d").drawImage(im,0,0,c.width,c.height);cb(c.toDataURL("image/jpeg",.7))};im.src=r.result};r.readAsDataURL(f)}

/* Smooth Curved Menu Drawer */
function menu(force){
 const m=$("pm"),s=$("menuShade");
 const open=force===true||(force!==false&&!m.classList.contains("open"));
 m.classList.toggle("open",open);
 s.classList.toggle("open",open);
}

function openVerifyHome(){
 const address=prompt("Enter your home address to verify:");
 if(address&&address.trim()){try{localStorage.setItem("bz_home_address",address.trim())}catch(e){}toast("Home address saved for verification")}
}

function goCategories(){resetHomePill();go("home");["n-home","n-categories","n-orders"].forEach(id=>{const el=$(id);if(el)el.classList.remove("on")});if($("n-categories"))$("n-categories").classList.add("on");setTimeout(()=>{const el=$("catHub");if(el)el.scrollIntoView({behavior:"smooth",block:"start"})},60)}

function openSellerTab(tab){
 sellerTab=tab;
 if(tab==="add")showNewProdForm=true;
 if(view!=="shop"){
  go("shop");
 }else{
  drawShop();
  updateNavActive();
  scrollTo(0,0);
 }
}

function updateBottomNav(mode){
 const on=subOn();
 const inShop=view==="shop";
 ["n-add-product","n-advertisement"].forEach(id=>{const el=$(id);if(el)el.classList.toggle("hidden-nav",!(on&&inShop))});
 ["n-categories","n-orders"].forEach(id=>{const el=$(id);if(el)el.classList.toggle("hidden-nav",inShop)});
}

const HOME_THEME=["#3b82f6","#f472b6","#2563eb","#22c55e","#facc15","#86efac","#fed7aa","#c4b5fd","#ef4444","#f3f4f6"];
let homeThemeIdx=-1;
function cycleHomeColor(){
 homeThemeIdx=(homeThemeIdx+1)%HOME_THEME.length;
 const c=HOME_THEME[homeThemeIdx];
 const ids={inner:"homeIn",outer:"homeOut",door:"homeDoor"};
 const ico=document.querySelector("#n-home .nav-ico");
 if(ico){ico.style.filter="none";ico.style.opacity="1";}
 const inner=document.getElementById(ids.inner);
 const outer=document.getElementById(ids.outer);
 const door=document.getElementById(ids.door);
 if(inner)inner.setAttribute("fill",c);
 if(outer)outer.setAttribute("stroke",c);
 if(door){door.setAttribute("fill",c);door.setAttribute("stroke",c);}
}
function resetHomePill(){
 const inner=document.getElementById("homeIn");
 const outer=document.getElementById("homeOut");
 const door=document.getElementById("homeDoor");
 if(inner)inner.setAttribute("fill","none");
 if(outer)outer.setAttribute("stroke","currentColor");
 if(door){door.setAttribute("fill","none");door.setAttribute("stroke","currentColor");}
 const ico=document.querySelector("#n-home .nav-ico");
 if(ico){ico.style.filter="";ico.style.opacity="";}
}
function updateNavActive(){
 if(view!=="home")resetHomePill();
 ["n-home","n-categories","n-orders","n-add-product","n-advertisement"].forEach(id=>{const el=$(id);if(el)el.classList.remove("on")});
 if(view==="shop"){
  if(sellerTab==="add"&&$("n-add-product"))$("n-add-product").classList.add("on");
  else if(sellerTab==="ads"&&$("n-advertisement"))$("n-advertisement").classList.add("on");
 }else{
  const b=$("n-"+view);if(b)b.classList.add("on");
 }
}

function setAv(f){if(f)rd(f,d=>{try{localStorage.setItem("bzp",d)}catch(e){}showAv(d)})}
function showAv(d){
 const a=$("menuAv"),h=$("av");
 if(d){
  if(a){a.style.backgroundImage="url("+d+")";a.textContent=""}
  if(h){h.style.backgroundImage="url("+d+")";h.textContent="";h.classList.add("has-photo")}
 }else{
  if(a){a.style.backgroundImage="";a.textContent="🙂"}
  if(h){h.style.backgroundImage="";h.textContent="☰";h.classList.remove("has-photo")}
 }
}
function addProd(){const f=$("pf").files[0];if(!f){toast("Please choose a product photo");return}rd(f,img=>addProd2(img))}
function addProd2(img){const sn=$("sn").value.trim(),n=$("pn").value.trim(),pr=Math.round(+$("pp").value),cost=Math.round(+$("costp").value),w=$("pw").value.trim();
 if(!sn||!n||!(pr>0)){toast("Enter shop name, product name and selling price");return}
 if(cost>pr){toast("Cost price cannot be higher than selling price");return}
 shopName=sn;
 const addedAt=new Date().toLocaleString("en-IN",{day:"2-digit",month:"short",year:"numeric",hour:"2-digit",minute:"2-digit"});
 const p={id:1000+Date.now()%1e9+SELL.length,n:esc(n),p:pr,cost:cost>0?cost:0,w:esc(w),o:pr,r:0,c:newProdCat,img,shop:esc(sn),addedAt};
 SELL.push(p);P.push(p);saveSell();if(window.fbPublish)window.fbPublish(p);toast("Product published to store");
 showNewProdForm=false;
 drawShop();upd()}
function delProd(id){if(window.fbRemove)window.fbRemove(id);SELL=SELL.filter(p=>p.id!==id);const i=P.findIndex(p=>p.id===id);if(i>=0)P.splice(i,1);delete cart[id];saved=saved.filter(x=>x!==id);save();saveSell();mh();drawMine();upd()}
function go(v){
 menu(false);
 if(v==="shop"){
  if(!window.bazaaroSellerAuthLoaded){toast("Seller account is loading. Please try again.");return}
  const u=window.bazaaroSellerUser||null;
  if(!u||!u.emailVerified||!window.bazaaroSellerProfile){openSellerAuth();return}
  const profile=window.bazaaroSellerProfile;
  shopName=profile.shopName||shopName;
 }
 if(v==="shop"&&view!=="shop")sellerTab="overview";
 view=v;
 updateBottomNav(v);
 ["home","cart","shop","orders","track"].forEach(k=>{$(k).style.display=k===v?"block":"none"});
 updateNavActive();
 if(v==="cart")drawCart();
 if(v==="shop")drawShop();
 if(v==="orders")drawOrders();
 if(v==="track")drawTrack();
 scrollTo(0,0);
}
applyLanguageUI();chips();upd();try{showAv(localStorage.getItem("bzp"))}catch(e){}

function downloadBazaroHtml(){
 try{
  const src = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
  const blob = new Blob([src], {type: "text/html;charset=utf-8"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "Bazaro_App_v90.html";
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(()=>URL.revokeObjectURL(url), 1500);
  toast("Bazaro_App_v90.html download started");
 }catch(e){
  toast("Use browser menu to save page as HTML");
 }
}

let wasOn=subOn();setInterval(()=>{saveSub();const a=subOn();if(a!==wasOn){wasOn=a;updateBottomNav();draw();if(view==="shop")drawShop();toast(a?"Plan activated":"Plan expired: seller panel locked")}},15000);
</script>
<script type="module">
import {initializeApp} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import {getFirestore,collection,doc,setDoc,deleteDoc,onSnapshot,getDoc} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
import {getAuth,onAuthStateChanged,createUserWithEmailAndPassword,signInWithEmailAndPassword,sendEmailVerification,sendSignInLinkToEmail,signOut, reload} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
const firebaseConfig={
  apiKey:"AIzaSyDlseiyR0yfKth6lwi1Yu4F9xXGHatKKyU",
  authDomain:"bazooro-38bc5.firebaseapp.com",
  projectId:"bazooro-38bc5",
  storageBucket:"bazooro-38bc5.firebasestorage.app",
  messagingSenderId:"750148794783",
  appId:"1:750148794783:web:a826ce0cac6f4998e225aa"
};
const app=initializeApp(firebaseConfig);
const db=getFirestore(app);
const auth=getAuth(app);
window.bazaaroSellerAuthLoaded=false;
window.bazaaroSellerUser=null;
window.bazaaroSellerProfile=null;
window.firebaseSellerErrorMessage=e=>{
 const map={
  "auth/email-already-in-use":"This email is already registered. Please login.",
  "auth/invalid-email":"Please enter a valid email address.",
  "auth/weak-password":"Password must be at least 6 characters.",
  "auth/invalid-credential":"Incorrect email or password.",
  "auth/too-many-requests":"Too many attempts. Please try again later.",
  "auth/network-request-failed":"Network error. Check your internet connection."
 };
 return map[e?.code]||e?.message||"Something went wrong.";
};
window.firebaseSellerRegister=async data=>{
 const cred=await createUserWithEmailAndPassword(auth,data.email,data.password);
 const profile={ownerName:data.ownerName,shopName:data.shopName,mobile:data.mobile,address:data.address,email:data.email,role:"seller",emailVerified:false,createdAt:new Date().toISOString()};
 await setDoc(doc(db,"sellers",cred.user.uid),profile);
 await sendEmailVerification(cred.user);
 window.bazaaroSellerUser=cred.user;
 window.bazaaroSellerProfile=profile;
 return true;
};
window.firebaseSellerLogin=async(email,password)=>{
 const cred=await signInWithEmailAndPassword(auth,email,password);
 await reload(cred.user);
 window.bazaaroSellerUser=auth.currentUser;
 const snap=await getDoc(doc(db,"sellers",cred.user.uid));
 window.bazaaroSellerProfile=snap.exists()?snap.data():null;
 return true;
};
window.firebaseSellerRefresh=async()=>{
 const u=auth.currentUser;if(!u)return false;
 await reload(u);
 window.bazaaroSellerUser=auth.currentUser;
 if(!auth.currentUser.emailVerified)return false;
 const snap=await getDoc(doc(db,"sellers",auth.currentUser.uid));
 if(!snap.exists())return false;
 const profile=snap.data();
 await setDoc(doc(db,"sellers",auth.currentUser.uid),{...profile,emailVerified:true},{merge:true});
 window.bazaaroSellerProfile={...profile,emailVerified:true};
 return true;
};
window.firebaseSellerResend=async()=>{
 if(!auth.currentUser)throw new Error("Please login again.");
 await sendEmailVerification(auth.currentUser);
};
window.firebaseSellerSignOut=async()=>{
 await signOut(auth);window.bazaaroSellerUser=null;window.bazaaroSellerProfile=null;
};
onAuthStateChanged(auth,async user=>{
 window.bazaaroSellerUser=user||null;
 window.bazaaroSellerProfile=null;
 if(user){
  try{
   const snap=await getDoc(doc(db,"sellers",user.uid));
   if(snap.exists()){
    const profile=snap.data();
    window.bazaaroSellerProfile=profile;
    if(user.emailVerified && profile.emailVerified!==true){
     await setDoc(doc(db,"sellers",user.uid),{emailVerified:true},{merge:true});
     window.bazaaroSellerProfile={...profile,emailVerified:true};
    }
   }
  }catch(e){console.error("Seller profile load failed",e)}
 }
 window.bazaaroSellerAuthLoaded=true;
});
window.fbPublish=p=>setDoc(doc(db,"products",String(p.id)),Object.assign({},p)).catch(e=>console.error("Publish failed",e));
window.fbRemove=id=>deleteDoc(doc(db,"products",String(id))).catch(e=>console.error("Remove failed",e));
onSnapshot(collection(db,"products"),snap=>{const list=[];snap.forEach(d=>list.push(d.data()));if(window.fbOnRemote)window.fbOnRemote(list)},e=>console.error("Listen failed",e));
</script>
</body>
