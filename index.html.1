function registerSellerAccount(){
 const data={
  ownerName:$("sellerOwner")?.value.trim()||"",
  shopName:$("sellerShop")?.value.trim()||"",
  mobile:$("sellerMobile")?.value.replace(/\D/g,"")||"",
  address:$("sellerAddress")?.value.trim()||"",
  email:$("sellerEmail")?.value.trim()||"",
  password:$("sellerPassword")?.value||""
 };
 if(!data.ownerName||!data.shopName||data.mobile.length!==10||!data.address||!data.email||data.password.length<6){
  toast("Fill all details. Mobile must be 10 digits and password at least 6 characters.");return;
 }
 if(!window.firebaseSellerRegister){toast("Firebase Authentication is still loading. Try again.");return}
 window.firebaseSellerRegister(data).then(()=>{
  toast("Verification email sent. Please check your inbox.");
  openSellerAuth();
 }).catch(e=>toast(window.firebaseSellerErrorMessage?window.firebaseSellerErrorMessage(e):e.message||"Registration failed"));
}
function loginSellerAccount(){
 const email=$("sellerEmail")?.value.trim()||"",password=$("sellerPassword")?.value||"";
 if(!email||!password){toast("Enter email and password");return}
 if(!window.firebaseSellerLogin){toast("Firebase Authentication is still loading. Try again.");return}
 window.firebaseSellerLogin(email,password).then(()=>{
  const u=window.bazaaroSellerUser;
  if(u&&!u.emailVerified){openSellerAuth();toast("Please verify your email first.");}
  else if(window.bazaaroSellerProfile){closePay();go("shop");}
  else{openSellerAuth();toast("Seller profile not found. Register a seller account.");}
 }).catch(e=>toast(window.firebaseSellerErrorMessage?window.firebaseSellerErrorMessage(e):e.message||"Login failed"));
}
function refreshSellerVerification(){
 if(window.firebaseSellerRefresh)window.firebaseSellerRefresh().then(ok=>{
  if(ok){closePay();go("shop");toast("Email verified. Welcome to your seller dashboard.");}
  else toast("Email not verified yet. Open the link in your email first.");
 }).catch(e=>toast(e.message||"Could not check verification"));
}
function resendSellerVerification(){
 if(window.firebaseSellerResend)window.firebaseSellerResend().then(()=>toast("Verification email sent again.")).catch(e=>toast(e.message||"Could not send email"));
}
function sellerAuthSignOut(){
