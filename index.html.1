<button id="n-categories" onclick="goCategories()"><span class="nav-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="gCat1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7dd3fc"/><stop offset="1" stop-color="#0284c7"/></linearGradient><linearGradient id="gCat2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fdba74"/><stop offset="1" stop-color="#ea580c"/></linearGradient><linearGradient id="gCat3" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fca5a5"/><stop offset="1" stop-color="#dc2626"/></linearGradient><linearGradient id="gCat4" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e2e8f0"/><stop offset="1" stop-color="#64748b"/></linearGradient></defs><rect x="3" y="3" width="8" height="8" rx="2.6" fill="url(#gCat2)"/><rect x="13" y="3" width="8" height="8" rx="2.6" fill="url(#gCat1)"/><rect x="3" y="13" width="8" height="8" rx="2.6" fill="url(#gCat3)"/><rect x="13" y="13" width="8" height="8" rx="2.6" fill="url(#gCat4)"/></svg></span><br><span id="navCatLbl">Categories</span></button>
<button id="n-orders" onclick="go('orders')"><span class="nav-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="4" y="3" width="16" height="18" rx="3" fill="#c08a4b" stroke="#8a5a2b" stroke-width="1.5"/><path d="M8 8h8M8 12h8M8 16h5" stroke="#ffffff" stroke-width="2" stroke-linecap="round"/></svg></span><br><span id="navOrdLbl">My Orders</span></button>
<button id="n-add-product" class="hidden-nav" onclick="openSellerTab('add')"><span class="nav-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="gAdd" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4ade80"/><stop offset="1" stop-color="#15803d"/></linearGradient></defs><rect x="2.5" y="2.5" width="19" height="19" rx="6" fill="url(#gAdd)"/><path d="M12 7.2v9.6M7.2 12h9.6" stroke="#ffffff" stroke-width="2.4" stroke-linecap="round"/></svg></span><br><span id="navAddLbl">Add Product</span></button>
<button id="n-advertisement" class="hidden-nav" onclick="go('shop');sellerTab='ads';drawShop();updateNavActive()"><span class="nav-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="gAd" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fb923c"/><stop offset="1" stop-color="#dc2626"/></linearGradient></defs><path d="M3 9.5h4l9-5v15l-9-5H3z" fill="url(#gAd)" stroke="#9a3412" stroke-width="1.2" stroke-linejoin="round"/><path d="M7 14.5l1.2 4.2a1.3 1.3 0 0 0 1.3 1h.8l-1.2-4.2" fill="#fdba74" stroke="#9a3412" stroke-width="1" stroke-linejoin="round"/><path d="M17.5 9.2q2 2.8 0 5.6" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round"/><path d="M19.8 7q3 5 0 10" fill="none" stroke="#fbbf24" stroke-width="1.8" stroke-linecap="round" opacity=".8"/></svg></span><br><span id="navAdsLbl">Advertisement</span></button>

</nav>
<div id="toast"></div>
<div id="paym" onclick="if(event.target===this)closePay()"><div class="sheet" id="paysheet"></div></div>
<div id="done"><div><h2 id="doneTitle">Order Placed!</h2><p id="oid"></p><button class="pay" style="margin:0" onclick="closeDone()" id="doneBtn">Continue Shopping</button></div></div>

